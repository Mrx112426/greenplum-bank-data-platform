COMPOSE_PROJECT_NAME=distributed-data-platform

# Docker images
POSTGRES_VERSION=16.15
AIRFLOW_VERSION=2.11.2
AIRFLOW_IMAGE_NAME=distributed-data-platform-airflow:2.11.2
MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z

# PostgreSQL source
SOURCE_POSTGRES_USER=source_user
SOURCE_POSTGRES_PASSWORD=source_password
SOURCE_POSTGRES_DB=source_db
SOURCE_POSTGRES_PORT=5433

# Airflow metadata database
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

# Airflow UI
AIRFLOW_UID=50000
AIRFLOW_WEB_PORT=8080
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_FIRSTNAME=Platform
AIRFLOW_ADMIN_LASTNAME=Admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_FERNET_KEY=

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=raw-data
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Greenplum DWH
GREENPLUM_IMAGE=andruche/greenplum:7
GREENPLUM_USER=gpadmin
GREENPLUM_PASSWORD=123456
GREENPLUM_DATABASE_NAME=dwh
GREENPLUM_PORT=5434

# Docker network
PLATFORM_NETWORK_NAME=data-platform-network
